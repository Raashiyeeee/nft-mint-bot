# ─────────────────────────────────────────────────────────────
# NFT Mint Bot — Environment Variables Template
# Copy this to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Telegram Bot Token — from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL
DB_PASSWORD=change_me_strong_random_password
DATABASE_URL=postgresql://nftbot:${DB_PASSWORD}@postgres:5432/nftbot_db

# Fernet encryption key for private keys at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_base64_here

# RPC API Keys — strongly recommended for competitive mints on ANY chain.
# Create apps for every network you mint on (ETH, Base, Arb, Optimism, Robinhood, …).
# Alchemy: https://dashboard.alchemy.com
# Infura:  https://infura.io (optional second paid provider)
INFURA_KEY=
ALCHEMY_KEY=

# OpenSea API key — shared by rust-engine + telegram-bot (avoids instant key rate limit)
# Get from: https://opensea.io/settings/developer
OPENSEA_API_KEY=

# Admin Telegram ID — auto-inserted into admin_users on first deploy
ADMIN_TELEGRAM_ID=1386285936

# Rust engine JSON-RPC endpoint (internal)
RUST_ENGINE_URL=http://127.0.0.1:7878

# Notification callback port (Python bot listens for push from Rust)
NOTIFICATION_PORT=7879

# Timezone for user-facing timestamps (e.g., Asia/Kolkata, America/New_York)
USER_TIMEZONE=Asia/Kolkata
